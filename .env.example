# Copia este archivo como .env (NUNCA lo subas a GitHub) y rellena solo lo que uses.

# --- Seguridad y costes ---
# Activado por defecto (aunque falte). Pon 0 SOLO si quieres permitir OpenAI/Claude y la voz/transcripción de pago.
FREE_ONLY=1
# Proveedor por defecto: github | gemini | groq | openrouter | openai | anthropic | offline
AI_PROVIDER=github
# Código que JARVIS pedirá antes de usar la IA (muy recomendable si el servidor es público)
JARVIS_ACCESS_CODE=
RATE_LIMIT_PER_MIN=20
# Tope diario global de peticiones a la IA (0 = sin tope)
DAILY_REQUEST_LIMIT=300

# --- GitHub Models (gratis, cuenta de GitHub, 13+) ---
# Token de acceso personal "fine-grained" con SOLO el permiso Models: Read-only
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# --- Google Gemini (nivel gratuito, 18+) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Groq (nivel gratuito, 18+): chat, visión y transcripción Whisper gratuita ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- OpenRouter (solo modelos ":free", 18+) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- OpenAI (de pago; inactivo con FREE_ONLY=1) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# --- Anthropic Claude (de pago; inactivo con FREE_ONLY=1) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Servidor ---
PORT=8787
TRUST_PROXY=0
HTTPS_CERT=
HTTPS_KEY=
