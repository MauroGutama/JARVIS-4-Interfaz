# Copia este archivo como .env (NUNCA lo subas a GitHub) y rellena tus valores.
# Proveedor de IA: openai | anthropic | offline (si se omite, se elige según la clave presente)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Voz natural y transcripción (requieren OPENAI_API_KEY)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Alternativa: Claude (Anthropic) para chat y visión
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Código que JARVIS pedirá antes de usar la IA (muy recomendable si el servidor es público)
JARVIS_ACCESS_CODE=
# Servidor
PORT=8787
RATE_LIMIT_PER_MIN=30
# Pon 1 si estás detrás de un proxy (Render, Fly, Railway...)
TRUST_PROXY=0
# HTTPS local opcional (rutas a certificado y clave)
HTTPS_CERT=
HTTPS_KEY=
